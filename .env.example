# =============================================================================
# Geospatial Microservices — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in values for your deployment.
# All variables have documented defaults; only override what you need.
#
# Requirement 4.6: .env.example with documented default values and descriptions.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Data Storage
# -----------------------------------------------------------------------------

# Root directory for all geospatial data files (COGs, MBTiles, raw uploads).
# Must be accessible by both the Ingestion Service and Tile Service (Server 1).
DATA_ROOT=./data

# -----------------------------------------------------------------------------
# 2. Database
# -----------------------------------------------------------------------------

# SQLAlchemy-compatible database URL.
# For PostGIS (production): postgresql+psycopg2://user:password@host:5432/gis_db
# For SQLite (development):  sqlite:///./offline_gis.db
DATABASE_URL=sqlite:///./offline_gis.db

# -----------------------------------------------------------------------------
# 3. API / Service Binding
# -----------------------------------------------------------------------------

# Host interface for all services.
# Set to the LAN IP of the server for multi-machine deployment.
# Example: API_HOST=192.168.1.10
API_HOST=127.0.0.1

# Default API port (used when a service-specific port is not set).
API_PORT=8000

# -----------------------------------------------------------------------------
# 4. Service URLs (used by clients and inter-service communication)
# -----------------------------------------------------------------------------

# Base URL of the TiTiler tile service (Server 1).
TITILER_BASE_URL=http://127.0.0.1:8002

# Base URL for offline CesiumJS assets served by the tile service.
CESIUM_BASE_URL=http://127.0.0.1:8002/cesium

# Base URL of the Ingestion Service (Server 1, port 8001).
INGESTION_SERVICE_URL=http://127.0.0.1:8001

# Base URL of the Query Service (Server 2, port 8003).
QUERY_SERVICE_URL=http://127.0.0.1:8003

# Base URL of the Tile Service (Server 1, port 8002).
TILE_SERVICE_URL=http://127.0.0.1:8002

# -----------------------------------------------------------------------------
# 5. Service Ports (used by service entry points via uvicorn)
# -----------------------------------------------------------------------------

# Port for the Ingestion Service (Server 1).
INGESTION_SERVICE_PORT=8001

# Port for the Tile Service / TiTiler (Server 1).
TILE_SERVICE_PORT=8002

# Port for the Query Service (Server 2).
QUERY_SERVICE_PORT=8003

# -----------------------------------------------------------------------------
# 6. Upload / Tile Limits
# -----------------------------------------------------------------------------

# Maximum allowed upload size in bytes.
# Default: 10737418240 (10 GB). Reduce for constrained environments.
MAX_UPLOAD_SIZE=10737418240

# Maximum number of tiles to keep in the in-memory LRU cache.
# Increase for better tile serving performance if RAM allows.
TILE_CACHE_SIZE=512

# -----------------------------------------------------------------------------
# 7. GDAL Performance Tuning
# -----------------------------------------------------------------------------

# Disable directory scanning when opening files — speeds up COG access.
# Valid values: EMPTY_DIR, NO, YES
GDAL_DISABLE_READDIR_ON_OPEN=EMPTY_DIR

# Merge consecutive HTTP byte-range requests — reduces round-trips for COGs.
# Valid values: YES, NO
GDAL_HTTP_MERGE_CONSECUTIVE_RANGES=YES

# -----------------------------------------------------------------------------
# 8. Security / Network (LAN air-gap configuration)
# -----------------------------------------------------------------------------

# Comma-separated list of allowed client IP addresses.
# Requests from IPs not in this list will receive 403 Forbidden.
# Example for LAN: ALLOWED_HOSTS=192.168.1.0/24,192.168.1.50
ALLOWED_HOSTS=127.0.0.1,::1

# Set to true to bind services to 0.0.0.0 (all interfaces).
# Leave false for LAN-only binding (recommended for air-gapped deployments).
BIND_ALL_INTERFACES=false

# -----------------------------------------------------------------------------
# 9. Logging
# -----------------------------------------------------------------------------

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log output format: "text" (human-readable) or "json" (structured/machine-readable)
LOG_FORMAT=text

# Path to log file. Leave empty to log to stdout only.
# Example: LOG_OUTPUT_PATH=/var/log/gis/service.log
LOG_OUTPUT_PATH=

# -----------------------------------------------------------------------------
# 10. Deployment Topology (optional — for legacy compatibility)
# -----------------------------------------------------------------------------

# Deployment mode: same-machine | split-lan | hybrid | distributed
DEPLOYMENT_TOPOLOGY=same-machine

# -----------------------------------------------------------------------------
# 11. TiTiler Configuration
# -----------------------------------------------------------------------------

# Tile matrix set used by TiTiler for tile coordinate calculations.
TITILER_TILE_MATRIX_SET_ID=WebMercatorQuad

# -----------------------------------------------------------------------------
# 12. Ingestion Pipeline Tuning (optional overrides)
# -----------------------------------------------------------------------------

# Maximum number of parallel ingest workers.
MAX_INGEST_WORKERS=5

# COG tile block size in pixels (512 is optimal for most use cases).
COG_BLOCKSIZE=512

# COG compression algorithm: LZW, DEFLATE, ZSTD, NONE
COG_COMPRESSION=LZW

# Resampling algorithm for COG overview levels: average, nearest, bilinear
COG_OVERVIEW_RESAMPLING=average

# Whether to organize processed outputs in timestamped subdirectories.
INGEST_ORGANIZE_OUTPUTS=true

# Base directory name for organized outputs (relative to DATA_ROOT).
INGEST_OUTPUT_BASE_DIR=processed_outputs
